# Keep the real key only in .env. The .env file is ignored by Git.
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_MODEL=deepseek/deepseek-v4.1-flash-1017
ROUTERAI_TIMEOUT_SECONDS=120
ROUTERAI_MAX_TOKENS=4000

# Platform: OPENAI_API_KEY and OPENAI_BASE_URL are supplied by Boosters.
# For local development --profile dev also accepts the legacy ROUTERAI_* variables.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://changellenge.up.railway.app/v1
# OPENAI_MODEL=qwen/qwen3.8-27b
# OPENAI_MODEL is optional on the platform (defaults to the organizer model).
