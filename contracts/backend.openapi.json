{
  "components": {
    "schemas": {
      "ApiError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "mock": {
            "default": false,
            "title": "Mock",
            "type": "boolean"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "Capabilities": {
        "additionalProperties": false,
        "properties": {
          "experiment_interface": {
            "const": "structured_recipe",
            "default": "structured_recipe",
            "title": "Experiment Interface",
            "type": "string"
          },
          "implemented": {
            "default": [
              "health",
              "capabilities",
              "history"
            ],
            "items": {
              "type": "string"
            },
            "title": "Implemented",
            "type": "array"
          },
          "stage": {
            "const": "infrastructure",
            "default": "infrastructure",
            "title": "Stage",
            "type": "string"
          },
          "unavailable": {
            "default": [
              "profile_data",
              "train",
              "evaluate"
            ],
            "items": {
              "type": "string"
            },
            "title": "Unavailable",
            "type": "array"
          }
        },
        "title": "Capabilities",
        "type": "object"
      },
      "EvaluateRequest": {
        "additionalProperties": false,
        "properties": {
          "experiment_id": {
            "minLength": 1,
            "title": "Experiment Id",
            "type": "string"
          }
        },
        "required": [
          "experiment_id"
        ],
        "title": "EvaluateRequest",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "default": "1.0.0",
            "title": "Contract Version",
            "type": "string"
          },
          "mock": {
            "default": false,
            "title": "Mock",
            "type": "boolean"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Health",
        "type": "object"
      },
      "History": {
        "additionalProperties": false,
        "properties": {
          "experiments": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Experiments",
            "type": "array"
          }
        },
        "title": "History",
        "type": "object"
      },
      "ProfileRequest": {
        "additionalProperties": false,
        "properties": {
          "dataset_ref": {
            "minLength": 1,
            "title": "Dataset Ref",
            "type": "string"
          }
        },
        "required": [
          "dataset_ref"
        ],
        "title": "ProfileRequest",
        "type": "object"
      },
      "TrainRequest": {
        "additionalProperties": false,
        "properties": {
          "dataset_ref": {
            "minLength": 1,
            "title": "Dataset Ref",
            "type": "string"
          },
          "recipe": {
            "additionalProperties": true,
            "title": "Recipe",
            "type": "object"
          }
        },
        "required": [
          "dataset_ref",
          "recipe"
        ],
        "title": "TrainRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "MLmom Backend",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
