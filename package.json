{
  "name": "mlmom",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "workspaces": ["packages/pi"],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "contracts": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test packages/pi/test/*.test.ts",
    "test:python": "node scripts/python.mjs -m pytest",
    "check": "npm run contracts:check && npm run typecheck && npm test && npm run test:python",
    "smoke:pi": "node --env-file-if-exists=.env --import tsx scripts/smoke-pi.ts",
    "smoke:router": "node --env-file-if-exists=.env --import tsx scripts/smoke-router.ts"
  },
  "dependencies": {
    "@agegr/pi-web": "0.12.2",
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-codemode": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-mcp": "1.2.0",
    "@earendil-works/pi-telemetry": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openapi-typescript": "^7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
